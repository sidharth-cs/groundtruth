# Copy to .env and fill in. Never commit .env.
#
# The entire test suite runs with NO key set — the offline model adapter is used
# automatically when LLM_PROVIDER=offline (the default). A key is only needed to
# run against a real model.

# ---- Model ----------------------------------------------------------------
# offline | anthropic
LLM_PROVIDER=offline
LLM_MODEL=claude-sonnet-4-20250514
ANTHROPIC_API_KEY=your-key-here

# ---- Database -------------------------------------------------------------
# docker compose sets this for you; override only for a native Postgres.
DATABASE_URL=postgresql://doctask:doctask@localhost:5432/doctask

# ---- Runtime --------------------------------------------------------------
LOG_LEVEL=INFO
# Hard ceiling on model calls per run. Protects against runaway loops.
MAX_MODEL_CALLS_PER_RUN=200
# Bounded retries before a stage escalates to a human instead of looping.
MAX_STAGE_RETRIES=2

# ---- Limits ---------------------------------------------------------------
# How much of a document reaches the model. Exceeding these is reported in the
# run's stages and noted in the register, never silently dropped.
CLASSIFY_CHAR_LIMIT=6000
EXTRACT_CHAR_LIMIT=20000
# Upload ceilings. Without these a single large file is an unauthenticated
# way to exhaust the server's memory.
MAX_UPLOAD_BYTES=10485760
MAX_UPLOAD_FILES=50
